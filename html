    height: 220px;
    width: 100%;
    overflow: hidden;
}

.culture__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.culture__card:hover .culture__img {
    transform: scale(1.08);
}

.culture__info {
    padding: 1.5rem;
}

.culture__info h3 {
    font-family: var(--font-heading);
    color: var(--primary-yellow);
    margin-bottom: .5rem;
    font-size: 1.15rem;
}

.culture__info p {
    color: var(--text-gray);
    font-size: 0.9rem;
    line-height: 1.6;
}

